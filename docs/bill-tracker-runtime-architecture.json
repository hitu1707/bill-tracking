    "cards":  [
                  {
                      "dot":  "cyan",
                      "title":  "Primary path - scan one bill",
                      "items":  [
                                    "ScanBill.jsx:120 posts multipart billImage to POST /api/bills/scan with the connect.sid cookie (api.js:5).",
                                    "upload.single() writes to backend/uploads; bill.service.js:43-45 then calls Gemini and Cloudinary in the same request.",
                                    "No queue or 202: the browser waits out the LLM round trip, 5248 ms observed in combined.log."
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "Trust boundaries",
                      "items":  [
                                    "app.js:31 pins CORS to one CLIENT_URL, but /api/health, /metrics and /uploads bypass the session gate.",
                                    "/uploads mounts at app.js:45 before the session middleware, so every bill image on disk is world-readable.",
                                    "upload.js:24 trusts the extension only, then forwards those bytes to Gemini and Cloudinary."
                                ]
                  },
                  {
                      "dot":  "violet",
                      "title":  "External dependencies, identity, runtime",
                      "items":  [
                                    "Gemini first (aiExtractor.js:132), Ollama llava second (:135), then throw - one attempt each, no retry.",
                                    "Cloudinary 403s live, so imageProcessor.js:55 falls back to a hardcoded localhost URL.",
                                    "Atlas holds bills, users and sessions; three OAuth providers plus Gmail carry the OTP.",
                                    "api.js:4 hardcodes the base URL; no Redis, no client cache, Loki auth_enabled: false."
                                ]
                  }
              ]
